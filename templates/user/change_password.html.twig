{% extends 'base.html.twig' %}

{% block title %}Zmiana hasła{% endblock %}

{% block body %}
    <h1>Zmiana hasła</h1>

    {{ form_start(form, { method: 'POST', action: path('user_change_password', {id: user.id}) }) }}
    {{ form_row(form.plainPassword) }}
    <div class="form-group row float-sm-right">
        <input type="submit" value="zapisz" class="btn btn-light"/>
    </div>
    {{ form_end(form) }}

    <div class="form-group row">
        <a href="{{ path('user_edit', {id: user.id}) }}" class="btn btn-outline-secondary">← wróć</a>
    </div>
{% endblock %}
