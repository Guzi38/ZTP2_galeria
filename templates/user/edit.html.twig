{% extends 'base.html.twig' %}

{% block title %}
    {{ 'Account'|trans({'%id%': user.id|default('')}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'account_id'|trans({'%id%': user.id|default('')}) }}</h1>

    {{ form_start(form, { method: 'PUT', action: path('user_edit', {id: user.id}) }) }}
    {{ form_row(form.email) }}
    <div class="form-group row float-sm-right">
        <input type="submit" value="{{ 'save_index'|trans }}" class="btn btn-light"/>
    </div>
    {{ form_end(form) }}

    <hr>
    <p>
        <a href="{{ path('user_change_password', {id: user.id}) }}" class="btn btn-outline-secondary">
            Zmień hasło
        </a>
    </p>

    <div class="form-group row float-sm-left">
        <a href="{{ url('user_index') }}" class="btn btn-outline-light">
            {{ 'back_to_previous_page'|trans }}
        </a>
    </div>
{% endblock %}
