{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.photo_details'|trans({'%id%': photo.id|default('')}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.photo_details'|trans({'%id%': photo.id|default('')}) }}</h1>

    {% if photo is defined and photo|length %}
        <dl class="dl-horizontal">
            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ photo.id }}</dd>
            <dt>{{ 'label.date'|trans }}</dt>
            <dd>{{ photo.createdAt|format_date('long') }}</dd>
            <dt>{{ 'label.title'|trans }}</dt>
            <dd>{{ photo.title }}</dd>
            <dt>{{ 'label.content'|trans }}</dt>
            <dd>{{ photo.content }}</dd>
            <dt>{{ 'label.gallery'|trans }}</dt>
            <dd>
                <a href="{{ url('gallery_show', {id: photo.gallery.id}) }}">
                    {{ photo.gallery.title }}
                </a>
            </dd>
            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>
                {% for tag in photo.tags %}
                    <a href="{{ url('tag_show', {id: tag.id}) }}">{{ tag.title }}{{ ',' }}</a>
                {% endfor %}
            </dd>
        </dl>
        <br>

        <img id="photo" src="{{ asset('uploads/photos/' ~ photo.filename) }}">

        <h4>{{ 'label_comments'|trans }}</h4>
        {% if is_granted('ROLE_USER') %}
            <p>
                <a href="{{ url('comment_create', {id: photo.id}) }}">
                    {{ 'action.create'|trans }}
                </a>
            </p>
        {% endif %}

        <table class="table table-striped">
            <tbody>
            {% for comment in photo.comments %}
                <tr>
                    <td>{{ comment.date|format_date('long') }}</td>
                    <td>{{ comment.content }}</td>
                    <td>{{ comment.author.login }}</td>
                    <td>
                        {% if is_granted('EDIT', comment) %}
                            <a href="{{ url('comment_edit', {id: comment.id}) }}" class="btn btn-warning">
                                {{ 'action.edit'|trans }}
                            </a>
                        {% endif %}
                        {% if is_granted('DELETE', comment) %}
                            <a href="{{ url('comment_delete', {id: comment.id}) }}" class="btn btn-danger">
                                {{ 'action.delete'|trans }}
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <p>
            <a href="{{ url('photo_index') }}" class="btn btn-secondary">
                {{ 'action.back_to_list'|trans }}
            </a>
        </p>
    {% else %}
        <p>{{ 'message.record_not_found'|trans }}</p>
    {% endif %}
{% endblock %}
